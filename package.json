{
  "name": "@3fv/ditsy",
  "version": "1.0.15",
  "packageManager": "pnpm@12.15.0",
  "description": "Extended from `async-injection` originally authored by Frank Stock",
  "author": "Jonathan Glanz",
  "license": "MIT",
  "keywords": [
    "ioc",
    "di",
    "async",
    "dependency",
    "injection",
    "dependency injection",
    "inversion of control",
    "injector",
    "container",
    "typescript"
  ],
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./lib/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/esm/index.d.ts",
        "default": "./lib/esm/index.js"
      },
      "require": {
        "types": "./lib/cjs/index.d.ts",
        "default": "./lib/cjs/index.js"
      }
    },
    "./*": {
      "import": {
        "types": "./lib/esm/*.d.ts",
        "default": "./lib/esm/*.js"
      },
      "require": {
        "types": "./lib/cjs/*.d.ts",
        "default": "./lib/cjs/*.js"
      }
    }
  },
  "files": [
    "lib",
    "!lib/*/__tests__",
    "!lib/**/*.tsbuildinfo",
    "README.md",
    "License.txt"
  ],
  "scripts": {
    "clean": "rimraf ./lib",
    "dev": "concurrently 'npm:build:watch' 'npm:test:watch'",
    "build": "node ./scripts/build.mjs",
    "build:watch": "pnpm run build --watch",
    "test": "jest",
    "test:debug": "node --inspect node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "jest --watchAll",
    "test:watch:debug": "node --inspect node_modules/jest/bin/jest.js --runInBand --watchAll",
    "preversion": "pnpm build && pnpm test",
    "release": "gh workflow run release.yml --ref master -f bump=patch"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3fv/ditsy.git"
  },
  "bugs": {
    "url": "https://github.com/3fv/ditsy/issues"
  },
  "dependencies": {
    "@3fv/deferred": "^1.2.17",
    "@3fv/guard": "^1.4.41",
    "@3fv/prelude-ts": "^0.8.45",
    "lodash": "^4.17.21",
    "reflect-metadata": "^0.1.13",
    "ts-pattern": "^3.3.5"
  },
  "devDependencies": {
    "@swc/core": "1.2.118",
    "@swc/helpers": "^0.3.8",
    "@swc/jest": "0.2.11",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.14.161",
    "@types/node": "^16.11.22",
    "@types/shelljs": "^0.8.15",
    "concurrently": "^7.0.0",
    "jest": "^30.5.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.5.1",
    "prettier-package-json": "^2.6.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-refresh": "^0.11.0",
    "regenerator-runtime": "^0.13.9",
    "rimraf": "^3.0.2",
    "shelljs": "^0.8.5",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.15",
    "ts-lint": "^4.5.1",
    "ts-node": "^10.4.0",
    "tsconfig-paths": "^3.12.0",
    "typescript": "^6.0.3",
    "zx": "^8.1.4"
  },
  "nyc": {
    "extends": "@istanbuljs/nyc-config-typescript",
    "all": true,
    "check-coverage": true
  }
}
